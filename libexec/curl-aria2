#!/bin/bash
# curl-aria2 - a curl-compatible shim that routes file downloads through aria2c.
#
# Homebrew selects this script when HOMEBREW_CURL_PATH points at it:
#   Library/Homebrew/utils/curl.sh  -> HOMEBREW_CURL="${HOMEBREW_CURL_PATH}"
#   Library/Homebrew/shims/shared/curl -> execs "${HOMEBREW_CURL}"
#
# Safety model: only curl options whose behavior we can preserve are routed to
# aria2c. Everything else is handed to the real curl unchanged.
#
# Tunables. Homebrew only forwards its own `HOMEBREW_*` variables to download
# subprocesses, so the HOMEBREW_-prefixed spelling is the one that works from
# Homebrew's brew.env file; the short spelling works from the calling shell for
# direct/manual use.
#   HOMEBREW_BREW_CURL_ARIA2_CONNECTIONS  connections per server (-x), default 8
#   HOMEBREW_BREW_CURL_ARIA2_SPLITS       parallel splits (-s), default = connections
#   HOMEBREW_BREW_CURL_ARIA2_CHUNK        split size (-k), default 1M
#   HOMEBREW_BREW_CURL_ARIA2_DEBUG=1      log backend decisions to stderr
#   HOMEBREW_BREW_CURL_ARIA2_LOG=path     append backend decisions to a file
#   HOMEBREW_BREW_CURL_ARIA2_PROGRESS     1/0 to force aria2c's console readout

set -u

orig=("$@")

CONNECTIONS="${HOMEBREW_BREW_CURL_ARIA2_CONNECTIONS:-${BREW_CURL_ARIA2_CONNECTIONS:-8}}"
SPLITS="${HOMEBREW_BREW_CURL_ARIA2_SPLITS:-${BREW_CURL_ARIA2_SPLITS:-$CONNECTIONS}}"
CHUNK="${HOMEBREW_BREW_CURL_ARIA2_CHUNK:-${BREW_CURL_ARIA2_CHUNK:-1M}}"
DEBUG="${HOMEBREW_BREW_CURL_ARIA2_DEBUG:-${BREW_CURL_ARIA2_DEBUG:-}}"
LOG="${HOMEBREW_BREW_CURL_ARIA2_LOG:-${BREW_CURL_ARIA2_LOG:-}}"
PROGRESS="${HOMEBREW_BREW_CURL_ARIA2_PROGRESS:-${BREW_CURL_ARIA2_PROGRESS:-}}"

log() {
  if [ -n "$DEBUG" ]; then printf 'curl-aria2: %s\n' "$*" >&2; fi
  if [ -n "$LOG" ]; then printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >>"$LOG" 2>/dev/null || true; fi
}

# --- locate the real curl (never ourselves) ---------------------------------
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
real_curl=""
for candidate in "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/curl/bin/curl" /usr/bin/curl; do
  if [ -x "$candidate" ] && [ "$candidate" != "$self" ]; then
    real_curl="$candidate"
    break
  fi
done
if [ -z "$real_curl" ]; then
  candidate="$(command -v curl 2>/dev/null || true)"
  if [ -n "$candidate" ] && [ "$candidate" != "$self" ]; then
    real_curl="$candidate"
  fi
fi
if [ -z "$real_curl" ]; then
  printf 'curl-aria2: no usable curl found\n' >&2
  exit 1
fi

to_curl() {
  # Never ask curl to resume an old aria2 sparse file. Inspect the original
  # arguments because routing can occur before argument parsing is complete.
  local i destination="" resume_arg=""
  for ((i=0; i<${#orig[@]}; i++)); do
    case "${orig[i]}" in
      --output|-o) destination="${orig[i+1]:-}" ;;
      --continue-at|-C) resume_arg="${orig[i+1]:-}" ;;
    esac
  done
  if [ -n "$resume_arg" ] && [ -n "$destination" ] && [ -e "$destination.aria2" ]; then
    log "backend=curl blocked reason=$1 legacy-aria2-state"
    printf 'curl-aria2: cannot resume aria2 pieces with curl (%s); retained download state\n' "$1" >&2
    exit 1
  fi
  log "backend=curl reason=$1"
  exec "$real_curl" "${orig[@]}"
}

# --- parse the arguments Homebrew passes to curl ----------------------------
out=""
url=""
ua=""
referer=""
retry=""
connect_timeout=""
location=0
progress=1
progress_bar=0
remote_time=0
ca_cert=""
create_dirs=0
post=0
head=0
dump_header=0
resume=0
headers=()
header_count=0

while [ $# -gt 0 ]; do
  case "$1" in
    --output|-o)
      [ $# -gt 1 ] || to_curl "missing-value:$1"
      [ -z "$out" ] || to_curl "multiple-outputs"
      out="$2"; shift 2 ;;
    --user-agent|-A)
      [ $# -gt 1 ] || to_curl "missing-value:$1"; ua="$2"; shift 2 ;;
    --header|-H)
      [ $# -gt 1 ] || to_curl "missing-value:$1"
      headers[header_count]="$2"
      header_count=$((header_count + 1))
      shift 2 ;;
    --referer|-e)
      [ $# -gt 1 ] || to_curl "missing-value:$1"; referer="$2"; shift 2 ;;
    --retry)
      [ $# -gt 1 ] || to_curl "missing-value:$1"
      case "$2" in ''|*[!0-9]*) to_curl "invalid-retry" ;; esac
      retry="$2"; shift 2 ;;
    --retry-delay|--retry-max-time|--max-time|-m|--speed-limit|-Y|--speed-time|-y)
      to_curl "unsupported-option:$1" ;;
    --connect-timeout)
      [ $# -gt 1 ] || to_curl "missing-value:$1"; connect_timeout="$2"; shift 2 ;;
    --cacert)
      [ $# -gt 1 ] || to_curl "missing-value:$1"; ca_cert="$2"; shift 2 ;;
    --cookie)
      [ $# -gt 1 ] || to_curl "missing-value:$1"
      # Homebrew normally passes /dev/null to start with an empty cookie jar.
      [ "$2" = /dev/null ] || to_curl "unsupported-cookie"
      shift 2 ;;
    --capath|-b|--cookie-jar|-c|-x|--proxy|--limit-rate)
      to_curl "unsupported-option:$1" ;;
    --continue-at|-C)
      [ $# -gt 1 ] || to_curl "missing-value:$1"
      # aria2 can infer the offset of a sequential file or read its own pieces.
      # Explicit numeric curl offsets have different semantics.
      [ "$2" = - ] || to_curl "explicit-resume-offset"
      resume=1; shift 2 ;;
    --data|--data-binary|--data-raw|--data-urlencode|-d|--form|-F)
      post=1; shift; if [ $# -gt 0 ]; then shift; fi ;;
    --request|-X)
      [ $# -gt 1 ] || to_curl "missing-value:$1"
      case "$2" in
        GET|get) shift 2 ;;
        *) post=1; shift 2 ;;
      esac ;;
    --head|-I)
      head=1; shift ;;
    --dump-header|-D)
      dump_header=1; shift; if [ $# -gt 0 ]; then shift; fi ;;
    --progress-bar)
      # This changes curl's meter style but does not undo --silent.
      progress_bar=1; shift ;;
    --remote-time|-R)
      remote_time=1; shift ;;
    --create-dirs)
      create_dirs=1; shift ;;
    -V|--version)
      to_curl "version-query" ;;
    --compressed|--http2|--http2-prior-knowledge|--tlsv1.2|--tlsv1.3|--ipv4|--ipv6|--retry-all-errors|--retry-connrefused|--fail-with-body)
      to_curl "unsupported-option:$1" ;;
    --location|-L)
      location=1; shift ;;
    --silent|-s|--no-progress-meter)
      progress=0; shift ;;
    --show-error|-S|--disable|-q|--globoff|-g|--http1.1|--fail|-f)
      shift ;;
    --)
      shift ;;
    -*)
      to_curl "unknown-option:$1" ;;
    *)
      [ -z "$url" ] || to_curl "multiple-urls"
      url="$1"; shift ;;
  esac
done

# --- decide whether this is a plain file download ---------------------------
[ -n "$out" ] || to_curl "no-output-option"
[ "$out" != - ] || to_curl "stdout-output"
[ -n "$url" ] || to_curl "no-url"
[ "$location" = 1 ] || to_curl "no-location-option"
[ "$post" = 0 ] || to_curl "request-with-body"
[ "$head" = 0 ] || to_curl "head-request"
[ "$dump_header" = 0 ] || to_curl "header-dump"
case "$url" in
  http://*|https://*) ;;
  *) to_curl "non-http-url" ;;
esac

# Homebrew runs download subprocesses with a filtered PATH that does not
# include the prefix, so never rely on `command -v` alone here.
aria2c=""
for candidate in "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/aria2c" \
                 "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/aria2/bin/aria2c"; do
  if [ -x "$candidate" ]; then
    aria2c="$candidate"
    break
  fi
done
if [ -z "$aria2c" ]; then
  candidate="$(command -v aria2c 2>/dev/null || true)"
  if [ -n "$candidate" ]; then
    aria2c="$candidate"
  fi
fi
[ -n "$aria2c" ] || to_curl "aria2c-not-installed"

outdir="$(dirname "$out")"
if [ ! -d "$outdir" ]; then
  if [ "$create_dirs" = 1 ]; then
    mkdir -p "$outdir" 2>/dev/null || to_curl "mkdir-failed"
  else
    to_curl "output-dir-missing"
  fi
fi
[ -w "$outdir" ] || to_curl "output-dir-not-writable"
if [ -e "$out" ] || [ -L "$out" ]; then
  [ "$resume" = 1 ] || to_curl "existing-output"
  [ -f "$out" ] && [ ! -L "$out" ] || to_curl "unsupported-output-type"
fi
if [ -e "$out.aria2" ] || [ -L "$out.aria2" ]; then
  [ "$resume" = 1 ] && [ -f "$out" ] && [ -f "$out.aria2" ] && [ ! -L "$out.aria2" ] || to_curl "existing-aria2-state"
fi

# Keep aria2's sparse file away from Homebrew's destination. Homebrew may
# treat a partial file whose apparent size equals Content-Length as complete.
# The destination remains a contiguous curl partial until publication.
# Homebrew matches downloads/<url hash>--* and can mistake any sibling
# directory for a completed cache file. Keep all state below a private root.
workroot="$outdir/.brew-curl-aria2"
[ ! -L "$workroot" ] || to_curl "unsupported-workroot"
if [ ! -e "$workroot" ]; then
  (umask 077; mkdir -p -- "$workroot") || to_curl "workroot-create-failed"
fi
[ -d "$workroot" ] || to_curl "unsupported-workroot"
workdir="$workroot/$(basename "$out")"
# Preserve known legacy pieces when the destination has not yet been confused
# by Homebrew's cache lookup. Other legacy directories require relocation.
legacy="$out.aria2-work"
if [ ! -e "$workdir" ] && [ ! -L "$legacy" ] && [ -d "$legacy" ] && [ -f "$legacy/url" ] && [ ! -L "$legacy/url" ]; then
  if [ "$(cat "$legacy/url")" = "$url" ]; then
    mv -- "$legacy" "$workdir" || to_curl "legacy-move-failed"
  fi
fi
if [ -e "$workdir" ] || [ -L "$workdir" ]; then
  [ -d "$workdir" ] && [ ! -L "$workdir" ] || to_curl "unsupported-workdir"
  [ -f "$workdir/url" ] && [ ! -L "$workdir/url" ] || to_curl "unrecognized-workdir"
  [ "$(cat "$workdir/url")" = "$url" ] || to_curl "workdir-url-mismatch"
  resume=1
else
  mkdir -m 700 -- "$workdir" || to_curl "workdir-create-failed"
  (umask 077; printf '%s\n' "$url" >"$workdir/url") || to_curl "workdir-url-write-failed"
  if [ "$resume" = 1 ] && [ -f "$out" ]; then
    # APFS cloning avoids copying a large sequential partial on macOS.
    if ! cp -c -p -- "$out" "$workdir/data" 2>/dev/null; then
      cp -p -- "$out" "$workdir/data" || to_curl "resume-copy-failed"
    fi
    if [ -f "$out.aria2" ]; then
      cp -p -- "$out.aria2" "$workdir/data.aria2" || to_curl "state-copy-failed"
    fi
  fi
fi
for staged in "$workdir/data" "$workdir/data.aria2"; do
  if [ -L "$staged" ] || { [ -e "$staged" ] && [ ! -f "$staged" ]; }; then
    to_curl "unsupported-staged-file"
  fi
done
cleanup_workdir() {
  rm -f -- "$workdir/data" "$workdir/data.aria2" "$workdir/url"
  rmdir -- "$workdir" 2>/dev/null || true
}

# --- build the aria2c invocation -------------------------------------------
args=(
  -x "$CONNECTIONS"
  -s "$SPLITS"
  -k "$CHUNK"
  --max-connection-per-server="$CONNECTIONS"
  --dir="$workdir"
  --out=data
  --continue=true
  --always-resume=true
  --auto-save-interval=1
  --auto-file-renaming=false
  --allow-overwrite=true
  --file-allocation=none
  --console-log-level=warn
  --summary-interval=0
  # keep aria2c's end-of-run result table out of Homebrew's stdout
  --download-result=hide
  --load-cookies=
  # use the system resolver (what curl uses) instead of aria2c's own c-ares;
  # on networks with split DNS / a transparent proxy, c-ares can fail to
  # resolve hosts that every other tool resolves fine (aria2c exit code 19)
  --async-dns=false
)
[ -n "$ua" ] && args+=("--user-agent=$ua")
[ -n "$referer" ] && args+=("--referer=$referer")
[ -n "$ca_cert" ] && args+=("--ca-certificate=$ca_cert")
[ -n "$connect_timeout" ] && args+=("--connect-timeout=$connect_timeout")
if [ -n "$retry" ]; then
  args+=(--max-tries=$((retry + 1)) --retry-wait=1)
fi
[ "$remote_time" = 1 ] && args+=(--remote-time=true)
if [ "$header_count" -gt 0 ]; then
  for h in "${headers[@]}"; do
    args+=("--header=$h")
  done
fi
show_readout=0
if [ "$PROGRESS" = "1" ]; then
  show_readout=1
elif [ "$PROGRESS" != "0" ] && [ "$progress" = 1 ]; then
  # Homebrew captures both streams through pipes even in an interactive
  # terminal. Honor curl's requested progress instead of testing our stdout.
  show_readout=1
fi
if [ "$show_readout" = 1 ]; then
  args+=(--show-console-readout=true --truncate-console-readout=true)
  # Readouts must remain visible through Homebrew's capture pipes. Plain
  # text also avoids color escapes when the wrapper itself has no terminal.
  [ -t 1 ] || args+=(--enable-color=false)
else
  args+=(--show-console-readout=false)
fi

# Homebrew's parallel renderer polls its .incomplete file, rather than child
# output. Mirror real, completed pieces through a small Ruby supervisor. Keep
# sparse pieces private and preserve curl's normal resume/exit-code contract.
aria2_runner=("$aria2c")
progress_helper="$(dirname "$self")/contiguous-progress.rb"
progress_ruby="${HOMEBREW_RUBY_PATH:-}"
if [ -z "$progress_ruby" ] || [ ! -x "$progress_ruby" ]; then
  progress_ruby="$(command -v ruby 2>/dev/null || true)"
fi
if [[ "$(basename "$out")" =~ ^[0-9a-f]{64}--.+[.]incomplete$ ]] &&
   { [ "$progress" = 0 ] || [ "${HOMEBREW_DOWNLOAD_CONCURRENCY:-auto}" != 1 ]; } &&
   [ -f "$progress_helper" ] && [ -n "$progress_ruby" ] && [ -x "$progress_ruby" ] &&
   [ ! -e "$out.aria2" ] &&
   [ "${HOMEBREW_BREW_CURL_ARIA2_NATIVE_PROGRESS:-1}" != 0 ]; then
  aria2_runner=("$progress_ruby" "$progress_helper" "$workdir" "$out" "$aria2c")
  args+=(--disk-cache=0 --stream-piece-selector=inorder)
fi

log "backend=aria2c url=$url out=$out connections=$CONNECTIONS resume=$resume"
errfile=""
if [ -n "$LOG" ] || [ -n "$DEBUG" ]; then
  errfile="$(mktemp 2>/dev/null || true)"
fi
invoke_aria2() {
  if [ "$show_readout" = 1 ]; then
    # aria2 buffers carriage-return readouts on piped stdout. stderr is
    # unbuffered; merge it into our newline relay before Homebrew captures it.
    if [ -n "$errfile" ]; then
      "${aria2_runner[@]}" "${args[@]}" --stderr=true -- "$url" 2>&1 | tee "$errfile"
      return "${PIPESTATUS[0]}"
    else
      "${aria2_runner[@]}" "${args[@]}" --stderr=true -- "$url" 2>&1
    fi
  elif [ -n "$errfile" ]; then
    "${aria2_runner[@]}" "${args[@]}" -- "$url" 2>"$errfile"
  else
    "${aria2_runner[@]}" "${args[@]}" -- "$url"
  fi
}
# Homebrew's ReadlineNonblock only forwards newline-terminated records.
# aria2's carriage-return-only readout would otherwise arrive at EOF. Emit a
# newline for each update, and redraw the previous row when a bar was requested.
stream_progress() {
  local character="" record="" previous_status=0 status=0
  # Read directly with Bash: stdio-based text filters may themselves buffer
  # short carriage-return records until the upstream process closes its pipe.
  while IFS= read -r -n 1 character; do
    case "$character" in
      ''|$'\r')
        [ -n "$record" ] || continue
        case "$record" in '[#'*) status=1 ;; *) status=0 ;; esac
        if [ "$status" = 1 ] && [ "$progress_bar" = 1 ] && [ "$previous_status" = 1 ]; then
          printf '\033[1A\033[2K\r%s\n' "$record"
        else
          printf '%s\n' "$record"
        fi
        previous_status="$status"
        record="" ;;
      *) record="$record$character" ;;
    esac
  done
  [ -z "$record" ] || printf '%s\n' "$record"
  return 0
}
run_aria2() {
  if [ "$show_readout" = 1 ]; then
    invoke_aria2 | stream_progress
    return "${PIPESTATUS[0]}"
  else
    invoke_aria2
  fi
}
run_aria2
rc=$?
if [ "$rc" = 8 ]; then
  # Invalid/unsupported range response: start a single aria2 stream from zero.
  # Only staged files are discarded; the original partial remains untouched.
  log "range-unsupported -> restarting aria2c with one connection"
  rm -f -- "$workdir/data" "$workdir/data.aria2"
  args+=(--continue=false -x 1 -s 1 --max-connection-per-server=1)
  run_aria2
  rc=$?
fi

if [ "$rc" -ne 0 ] || [ ! -s "$workdir/data" ] || [ -e "$workdir/data.aria2" ]; then
  if [ -n "$errfile" ] && [ -s "$errfile" ]; then
    log "aria2c stderr: $(tail -3 "$errfile" | tr '\n' ' ')"
  fi
  [ -n "$errfile" ] && rm -f "$errfile"
  # The curl destination contains only a valid sequential prefix, so curl
  # can safely resume it (or overwrite it when the original request was fresh).
  # Keep aria2 pieces if curl also fails; the next attempt resumes those pieces.
  log "aria2c exit=$rc -> falling back to curl (staged progress retained)"
  if [ -e "$out.aria2" ]; then
    printf 'curl-aria2: aria2 download incomplete; retained pieces for retry\n' >&2
    [ "$rc" -ne 0 ] || rc=1
    exit "$rc"
  fi
  "$real_curl" "${orig[@]}"
  rc=$?
  [ "$rc" -ne 0 ] || cleanup_workdir
  exit "$rc"
fi
[ -n "$errfile" ] && rm -f "$errfile"

mv -f -- "$workdir/data" "$out" || exit 1
rm -f -- "$out.aria2"
cleanup_workdir
log "backend=aria2c ok bytes=$(wc -c <"$out" | tr -d ' ')"
exit 0
